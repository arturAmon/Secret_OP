<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained LeagueOverlay.exe for sharing: runs on any 64-bit Windows 10/11 PC without installing .NET.
  Nothing personal is baked in: API key, region, hotkeys and collected builds live in each user's
  %LOCALAPPDATA%\LeagueOverlay folder. Build it with publish.ps1 in the repository root.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\dist\</PublishDir>
  </PropertyGroup>
</Project>
