<Window x:Class="LeagueOverlay.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LeagueOverlay"
        Title="Secret OP"
        Style="{StaticResource DarkWindow}"
        Width="1240" Height="800" MinWidth="980" MinHeight="680" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
    <ScrollViewer Grid.Column="0" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <TextBlock>
            <Run Text="Secret OP" FontSize="20" FontWeight="Bold"/><Run x:Name="VersionRun" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </TextBlock>

        <!-- Status -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontWeight="SemiBold" Text="Waiting for a game"/>
        </StackPanel>
        <TextBlock x:Name="StatusDetail" Margin="17,2,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="The overlay appears on its own once you're past the loading screen."/>

        <!-- Hotkeys -->
        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Show / hide overlay" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="Move overlay" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="Stop app" Margin="0,3"/>
                <TextBlock x:Name="ToggleKeyText" Grid.Row="0" Grid.Column="1" Margin="0,3" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="MoveKeyText" Grid.Row="1" Grid.Column="1" Margin="0,3" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="QuitKeyText" Grid.Row="2" Grid.Column="1" Margin="0,3" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
            </Grid>
        </Border>

        <TextBlock x:Name="HotkeyWarning" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="League must run in Borderless or Windowed mode for the overlay to show on top of the game."/>
        <TextBlock x:Name="DataStatus" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Loading item data…"/>

        <!-- Popular builds (Riot API) -->
        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Popular builds" FontWeight="SemiBold"/>
                <TextBlock x:Name="BuildStatus" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Add your Riot API key in Settings to base item suggestions on what high-ranked players build."/>
                <ProgressBar x:Name="BuildProgress" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed"/>
                <TextBlock x:Name="ChampionBuildText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Champion select: champion suggestions, then your champion's starting items and shop item set -->
        <Border x:Name="ChampSelectCard" Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Champion select" FontWeight="SemiBold"/>
                <!-- Champion suggestions (before you lock in) -->
                <DockPanel Margin="0,8,0,0">
                    <ComboBox x:Name="PickModeBox" DockPanel.Dock="Right" Width="150" SelectionChanged="PickMode_Changed"
                              ToolTip="Best for the team: fits your team and the enemy draft. Surprise me: a random champion you've barely played.">
                        <ComboBoxItem Content="Off" Tag="Off"/>
                        <ComboBoxItem Content="Best for the team" Tag="Best"/>
                        <ComboBoxItem Content="Surprise me" Tag="Surprise"/>
                    </ComboBox>
                    <TextBlock Text="Champion suggestions" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel x:Name="PicksSection">
                    <TextBlock x:Name="PicksNote" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PicksList" Margin="0,4,0,0"/>
                    <Button x:Name="PickRerollButton" Content="Another one" HorizontalAlignment="Left" Margin="0,4,0,0" Click="PickReroll_Click"
                            ToolTip="Suggest a different champion you've barely played"/>
                    <TextBlock x:Name="HoverStatus" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Border x:Name="PicksDivider" Height="1" Background="{StaticResource LineBrush}" Margin="0,10,0,6"/>
                <TextBlock x:Name="ChampSelectText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ChampSelectStarterLabel" Text="Starting items" Margin="0,8,0,4" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <WrapPanel x:Name="ChampSelectStarter"/>
                <TextBlock x:Name="ItemSetStatus" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Runes for your champion (surprise build, popular page or a standard page), apply to the client -->
        <Border x:Name="RunesCard" Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="RuneOriginTag" DockPanel.Dock="Right" CornerRadius="9" Padding="8,2" VerticalAlignment="Center" BorderThickness="1">
                        <TextBlock x:Name="RuneOriginText" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Runes" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="RunesText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <ContentControl x:Name="ChampSelectRunes" Margin="0,8,0,0"/>
                <Button x:Name="ApplyRunesButton" Content="Apply rune page" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Click="ApplyRunes_Click" ToolTip="Create this rune page in the League client (named Secret OP) and select it"/>
                <CheckBox x:Name="ReplacePageBox" Margin="0,8,0,0" FontSize="12"
                          Content="If no rune page is free, replace the current one" Checked="ReplacePage_Changed" Unchecked="ReplacePage_Changed"/>
                <TextBlock x:Name="ApplyRunesStatus" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Rival -->
        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Rival" FontWeight="SemiBold"/>
                <TextBlock x:Name="RivalText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Surprise build mode -->
        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <StackPanel>
                <DockPanel>
                    <CheckBox x:Name="SurpriseBox" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="Surprise_Changed" Unchecked="Surprise_Changed"
                              ToolTip="Turn surprise build mode on or off"/>
                    <TextBlock Text="Surprise build mode" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBlock x:Name="SurpriseTitle" Margin="0,6,0,0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent3Brush}" Visibility="Collapsed"/>
                <TextBlock x:Name="SurpriseText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Off. When on, every game gets an unexpected build your champion still scales with (AP Ezreal, healing Senna...)."/>
                <WrapPanel x:Name="SurpriseItems" Margin="0,6,0,0"/>
                <ContentControl x:Name="SurpriseRunes" Margin="0,6,0,0"/>
                <StackPanel x:Name="SurpriseButtons" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                    <Button x:Name="RerollButton" Content="Reroll" Click="Reroll_Click" ToolTip="Pick a different surprise build for this game"/>
                    <Button x:Name="BlockButton" Content="Don't suggest this again" Margin="6,0,0,0" Click="Block_Click"
                            ToolTip="Never suggest this style on this champion again (and pick another one now)"/>
                </StackPanel>
                <DockPanel x:Name="BlockedRow" Margin="0,8,0,0" LastChildFill="True" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Content="Allow all again" Click="UnblockAll_Click" Padding="8,2" FontSize="11"/>
                    <TextBlock x:Name="BlockedText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="SettingsButton" DockPanel.Dock="Left" Content="Settings" Style="{StaticResource AccentButton}" Click="Settings_Click"/>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>

    <!-- Right side: "This game" (live graph) and "History" (last 10 games) -->
    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="14,12">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="LiveTab" Style="{StaticResource TabButton}" Content="This game" Checked="Tab_Checked"/>
                <RadioButton x:Name="HistoryTab" Style="{StaticResource TabButton}" Content="History" Margin="6,0,0,0" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="CollectionTab" Style="{StaticResource TabButton}" Margin="6,0,0,0" Checked="Tab_Checked" AutomationProperties.Name="Collection"
                             ToolTip="Your surprise games, achievements and the share image styles they unlock">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Collection"/>
                        <Ellipse x:Name="CollectionDot" Width="7" Height="7" Fill="{StaticResource Accent3Brush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <Grid>
        <DockPanel x:Name="LivePanel" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                <CheckBox x:Name="ComponentsBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                          Content="Show components" Checked="Components_Changed" Unchecked="Components_Changed"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#1CA6AE" VerticalAlignment="Center"/>
                    <TextBlock Text="Your team ahead" Margin="6,0,14,0" FontSize="12"/>
                    <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#B02FA0" VerticalAlignment="Center"/>
                    <TextBlock Text="Enemy ahead" Margin="6,0,0,0" FontSize="12"/>
                </StackPanel>
                <!-- Last, so the legend keeps its width and this wraps instead -->
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Gold difference" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Your team's item gold minus the enemy's, the same numbers as the overlay. Hover for details."/>
                </StackPanel>
            </DockPanel>
            <!-- You vs your lane opponent, filled in code while a game runs -->
            <ContentControl x:Name="MatchupHost" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed"/>
            <!-- You vs your rival, when they're in this game -->
            <ContentControl x:Name="RivalHost" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed"/>
            <local:GoldGraph x:Name="Graph"/>
        </DockPanel>

        <!-- History: list of the last 10 games, details of the selected one -->
        <Grid x:Name="HistoryPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Your last 10 games: recorded live by the app, or fetched from Riot's match history."/>
                <Button x:Name="ImportButton" DockPanel.Dock="Top" Content="Get my recent games from Riot" Margin="0,0,0,4" Click="Import_Click"/>
                <TextBlock x:Name="ImportStatus" DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListBox x:Name="GameList" Style="{StaticResource DarkList}" SelectionChanged="GameList_SelectionChanged"/>
            </DockPanel>
            <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="GameDetail"/>
            </ScrollViewer>
            <TextBlock x:Name="NoHistoryText" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Visibility="Collapsed"
                       Text="No games yet. Games you play while the app is running show up here once they end."/>
        </Grid>

        <!-- Collection: surprise game count, achievements, share image styles (filled in code) -->
        <ScrollViewer x:Name="CollectionPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CollectionHost"/>
        </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
    </Grid>
</Window>
