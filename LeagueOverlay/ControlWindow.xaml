<Window x:Class="LeagueOverlay.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LeagueOverlay"
        Title="League Overlay"
        Style="{StaticResource DarkWindow}"
        Width="1240" Height="800" MinWidth="980" MinHeight="680" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,20,0">
        <TextBlock>
            <Run Text="League Overlay" FontSize="20" FontWeight="Bold"/><Run x:Name="VersionRun" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </TextBlock>

        <!-- Status -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontWeight="SemiBold" Text="Waiting for a game"/>
        </StackPanel>
        <TextBlock x:Name="StatusDetail" Margin="17,2,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="The overlay appears on its own once you're past the loading screen."/>

        <!-- Hotkeys -->
        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Show / hide overlay" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="Move overlay" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="Stop app" Margin="0,3"/>
                <TextBlock x:Name="ToggleKeyText" Grid.Row="0" Grid.Column="1" Margin="0,3" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="MoveKeyText" Grid.Row="1" Grid.Column="1" Margin="0,3" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="QuitKeyText" Grid.Row="2" Grid.Column="1" Margin="0,3" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
            </Grid>
        </Border>

        <TextBlock x:Name="HotkeyWarning" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="League must run in Borderless or Windowed mode for the overlay to show on top of the game."/>
        <TextBlock x:Name="DataStatus" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Loading item data…"/>

        <!-- Popular builds (Riot API) -->
        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Popular builds" FontWeight="SemiBold"/>
                <TextBlock x:Name="BuildStatus" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Add your Riot API key in Settings to base item suggestions on what high-ranked players build."/>
                <ProgressBar x:Name="BuildProgress" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed"/>
                <TextBlock x:Name="ChampionBuildText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Rival -->
        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Rival" FontWeight="SemiBold"/>
                <TextBlock x:Name="RivalText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="SettingsButton" DockPanel.Dock="Left" Content="Settings" Style="{StaticResource AccentButton}" Click="Settings_Click"/>
        </DockPanel>
    </StackPanel>

    <!-- Right side: "This game" (live graph) and "History" (last 10 games) -->
    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="14,12">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="LiveTab" Style="{StaticResource TabButton}" Content="This game" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="HistoryTab" Style="{StaticResource TabButton}" Content="History" Margin="6,0,0,0" Checked="Tab_Checked"/>
            </StackPanel>

            <Grid>
        <DockPanel x:Name="LivePanel">
            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                <CheckBox x:Name="ComponentsBox" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                          Content="Show components" Checked="Components_Changed" Unchecked="Components_Changed"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#3D8EF0" VerticalAlignment="Center"/>
                    <TextBlock Text="Your team ahead" Margin="6,0,14,0" FontSize="12"/>
                    <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#F0603C" VerticalAlignment="Center"/>
                    <TextBlock Text="Enemy ahead" Margin="6,0,0,0" FontSize="12"/>
                </StackPanel>
                <!-- Last, so the legend keeps its width and this wraps instead -->
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Gold difference" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Your team's item gold minus the enemy's, the same numbers as the overlay. Hover for details."/>
                </StackPanel>
            </DockPanel>
            <!-- You vs your lane opponent, filled in code while a game runs -->
            <ContentControl x:Name="MatchupHost" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed"/>
            <!-- You vs your rival, when they're in this game -->
            <ContentControl x:Name="RivalHost" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed"/>
            <local:GoldGraph x:Name="Graph"/>
        </DockPanel>

        <!-- History: list of the last 10 games, details of the selected one -->
        <Grid x:Name="HistoryPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Your last 10 games: recorded live by the app, or fetched from Riot's match history."/>
                <Button x:Name="ImportButton" DockPanel.Dock="Top" Content="Get my recent games from Riot" Margin="0,0,0,4" Click="Import_Click"/>
                <TextBlock x:Name="ImportStatus" DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListBox x:Name="GameList" Style="{StaticResource DarkList}" SelectionChanged="GameList_SelectionChanged"/>
            </DockPanel>
            <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="GameDetail"/>
            </ScrollViewer>
            <TextBlock x:Name="NoHistoryText" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Visibility="Collapsed"
                       Text="No games yet. Games you play while the app is running show up here once they end."/>
        </Grid>
            </Grid>
        </DockPanel>
    </Border>
    </Grid>
</Window>
