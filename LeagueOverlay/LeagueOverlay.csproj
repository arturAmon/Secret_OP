<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LeagueOverlay.Core\LeagueOverlay.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- LibraryImport (Native.cs) generates unsafe marshalling code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LeagueOverlay</AssemblyName>
    <Version>1.10.0</Version>
    <Product>League Overlay</Product>
    <ApplicationIcon>skibidi_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window and taskbar icon (pack://application:,,,/skibidi_icon.ico) -->
    <Resource Include="skibidi_icon.ico" />
  </ItemGroup>

</Project>
